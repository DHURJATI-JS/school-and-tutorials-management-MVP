# =====================================================================
#  ClassNest configuration - copy to .env and fill in
# =====================================================================

# ---- Application -----------------------------------------------------
APP_NAME=ClassNest
APP_TAGLINE=AI-powered classrooms for small schools & tuition centres
APP_ENV=development
DEBUG=false
SECRET_KEY=replace-with-a-long-random-string
# Public address used in emails / links. For phones & laptops on your LAN use e.g. https://192.168.0.200:8080
BASE_URL=http://localhost:8080
HOST=0.0.0.0
PORT=8080
TIMEZONE=Asia/Kolkata
CURRENCY_SYMBOL=₹
# HTTPS (camera & microphone need HTTPS on anything except localhost): python -m app.cli make-cert
SSL_CERTFILE=
SSL_KEYFILE=
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_HOURS=12
# Behind a reverse proxy (nginx, Caddy...) set TRUST_PROXY_HEADERS=true and list the proxy's IP(s) here.
# X-Forwarded-For from anyone else is ignored (it would let clients fake their IP to dodge bans/limits).
TRUST_PROXY_HEADERS=false
FORWARDED_ALLOW_IPS=127.0.0.1
# Seconds an idle connection stays open between requests (longer than the 30 s notification poll; behind a
# reverse proxy, keep it longer than the proxy's upstream idle timeout)
KEEP_ALIVE_SECONDS=75

# ---- Admins (dict of username -> password). Values may be bcrypt hashes (recommended) or plain text.
# Example values below are plain text; prefer bcrypt hashes in production.
# New hash:  python -m app.cli hash-password
ADMIN_USERS='{"admin": "ChangeMe@123", "principal": "ChangeMe@456"}'
# Who receives warnings (missed live classes, bans, reports, payment proofs). Comma separated; empty = CONTACT_EMAIL
ADMIN_ALERT_EMAILS=

# ---- PostgreSQL + pgvector  (docker compose up -d db) -----------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=classnest
POSTGRES_USER=classnest
POSTGRES_PASSWORD=change-me
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
DB_POOL_TIMEOUT_SECONDS=30
DB_ECHO=false

# ---- AI provider ------------------------------------------------------------------
# auto      = Gemma 3 on THIS PC's GPU when one is found (NVIDIA on Windows/Linux, AMD on Linux+ROCm),
#             otherwise Claude when ANTHROPIC_API_KEY is set, otherwise the OpenAI-compatible gateway below
# local     = always the local vLLM container          anthropic = Claude through the Anthropic API
# openai    = the gateway in OPENAI_BASE_URL            off       = no AI (built-in fallbacks everywhere)
AI_PROVIDER=auto

# ---- Local Gemma 3 on vLLM (run.py starts the Docker container and links the app) -------------
# Leave empty to pick by GPU memory: <11.5 GB -> gemma-3-1b-it, >=11.5 GB -> 4b, >=31 GB -> 12b.
# unsloth/* = ungated copies of Google's Gemma 3 weights (Gemma licence). For google/gemma-3-* add HF_TOKEN.
VLLM_MODEL=
VLLM_MAX_MODEL_LEN=
VLLM_GPU_MEMORY_UTILIZATION=
# Host port of the model's API (8000 is left free for the web app and other tools)
VLLM_PORT=8002
HF_TOKEN=
# VLLM_IMAGE=vllm/vllm-openai:v0.33.0      # NVIDIA image
# VLLM_AMD_IMAGE=rocm/vllm:latest          # AMD Instinct (CDNA); the default tag targets Radeon RX 7000/9000

# ---- Claude (Anthropic API) - when you don't want to run the model locally ------------------
# Get a key at https://platform.claude.com, paste it below and set AI_PROVIDER=anthropic (or leave auto on a PC
# without a GPU). Cheaper/faster: ANTHROPIC_MODEL=claude-sonnet-5-5 or claude-haiku-5-5; ANTHROPIC_EFFORT=low.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=16000

# ---- AI endpoint (OpenAI-compatible) - the vLLM container above ----------------------------
# run.py fills both in automatically when it starts the container (the key is generated per install).
# You can also point this at another OpenAI-compatible server (Ollama, LM Studio...) with AI_PROVIDER=openai.
OPENAI_BASE_URL=http://127.0.0.1:8002/v1
OPENAI_API_KEY=
# "auto" picks the first model containing "gemma" from GET /v1/models (falls back to LLM_FALLBACK_MODEL)
LLM_MODEL=auto
LLM_FALLBACK_MODEL=gemma
# auto | true | false - Gemma 3 can read video screenshots; falls back to OCR text automatically
LLM_VISION=auto
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
AI_MAX_CONCURRENCY=4
AI_CIRCUIT_FAILURES=3
AI_CIRCUIT_COOLDOWN_SECONDS=60
# Optional semantic embeddings from the gateway (e.g. nomic-embed-text). Empty = built-in lexical vectors only.
EMBEDDING_MODEL=
EMBEDDING_DIM=768
# Optional speech-to-text model on the gateway (e.g. whisper-1). Empty = browser live captions only.
TRANSCRIBE_MODEL=

# ---- OCR micro-service (Tesseract, docker compose up -d ocr) -----------
OCR_SERVICE_URL=http://localhost:8001
OCR_SHARED_SECRET=replace-with-a-random-string
OCR_TIMEOUT_SECONDS=60

# ---- Email (SMTP). Default = Mailpit dev inbox at http://localhost:8025 --
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_STARTTLS=true + an App Password
EMAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_FROM_EMAIL=no-reply@classnest.local
SMTP_FROM_NAME=ClassNest
SMTP_TIMEOUT_SECONDS=20

# ---- SMS for OTPs: console (dev - printed in the server log) | twilio | webhook
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
DEFAULT_COUNTRY_CODE=+91

# ---- Cashfree (optional). When NOT set up, payment proofs (screenshots) are mandatory.
CASHFREE_ENABLED=false
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01
CASHFREE_PAYOUTS_ENABLED=false
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
CASHFREE_PAYOUT_API_VERSION=2024-01-01

# ---- Your school's public contact details (home page, e-mails, receipts, ban notices) - replace these ----
CONTACT_EMAIL=contact@example.com
CONTACT_WHATSAPP=+910000000000
CONTACT_PHONE=+91 00000 00000
CONTACT_ADDRESS=India

# ---- Academic rules ---------------------------------------------------------
MAX_BATCHES=12
MIN_BATCH_MINUTES=60
MAX_DAILY_HOURS=12
# Days on which nothing can be assigned or due (comma separated: mon,tue,...,sun)
WEEKLY_OFF_DAYS=sun
# Attendance: 50% of a video watched, or (practically) the whole live class (0.9 tolerates network blips)
VIDEO_ATTENDANCE_RATIO=0.5
MEETING_ATTENDANCE_RATIO=0.9
TEST_GRACE_SECONDS=60

# ---- Sign-in ------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
REQUIRE_OTP_FOR_PASSWORD_LOGIN=false
LOGIN_RATE_LIMIT=10
# Failed sign-ins per ACCOUNT (from any IP) before it is locked for ACCOUNT_LOCK_MINUTES
ACCOUNT_LOCK_THRESHOLD=10
ACCOUNT_LOCK_MINUTES=15
# Sign-in codes sent to one person per hour / wrong codes allowed per person per hour
OTP_SENDS_PER_HOUR=5
OTP_FAILURES_PER_HOUR=10

# ---- Chat moderation (abusive words are masked; strikes lead to an automatic IP ban)
ABUSE_MAX_STRIKES=3
ABUSE_WINDOW_HOURS=24
# 0 = permanent until an admin lifts it
ABUSE_BAN_HOURS=72
# Extra words to block (comma separated, stored as you type them)
EXTRA_BLOCKED_WORDS=
CHAT_RATE_LIMIT=12
REPORTS_PER_HOUR=5
MAX_SOCKETS_PER_USER=8

# ---- Uploads ------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15
# Largest non-file request (form / JSON); admin pages allow 8 MB, uploads have their own limits
MAX_FORM_MB=2
MAX_VIDEO_MB=2048

# ---- Live classes (WebRTC) ------------------------------------------------------
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- Background jobs & assets ----------------------------------------------------
JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=300
PERFORMANCE_CHECK_HOURS=24
NOTIFY_PARENTS=true
MINIFY_ASSETS=true
